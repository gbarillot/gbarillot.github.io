---
import type { Form as Props } from '~/types';
import Button from '~/components/ui/Button.astro';

const { inputs, textarea, disclaimer, button = 'Contact us', description = '', action } = Astro.props;
---

<form method="POST" action={action}>
  {
    inputs &&
      inputs.map(
        ({ type = 'text', name, label = '', autocomplete = 'on', placeholder = '', required = false }) =>
          name && (
            <div class="mb-6">
              {label && (
                <label for={name} class="block text-sm font-medium">
                  {label}
                </label>
              )}
              <input
                type={type}
                name={name}
                id={name}
                autocomplete={autocomplete}
                placeholder={placeholder}
                required={required}
                class="py-3 px-4 block w-full text-md rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900"
              />
            </div>
          )
      )
  }

  {
    textarea && (
      <div>
        <label for="textarea" class="block text-sm font-medium">
          {textarea.label}
        </label>
        <textarea
          id="textarea"
          name={textarea.name ? textarea.name : 'message'}
          rows={textarea.rows ? textarea.rows : 4}
          placeholder={textarea.placeholder}
          required={textarea.required}
          class="py-3 px-4 block w-full text-md rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900"
        />
      </div>
    )
  }

  {
    disclaimer && (
      <div class="mt-3 flex items-start">
        <div class="flex mt-0.5">
          <input
            id="disclaimer"
            name="disclaimer"
            type="checkbox"
            required={disclaimer.required}
            class="cursor-pointer mt-1 py-3 px-4 block w-full text-md rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900"
          />
        </div>
        <div class="ml-3">
          <label for="disclaimer" class="cursor-pointer select-none text-sm text-gray-600 dark:text-gray-400">
            {disclaimer.label}
          </label>
        </div>
      </div>
    )
  }

  {
    button && (
      <div class="mt-10 grid">
        <Button variant="primary" type="submit">
          {button}
        </Button>
      </div>
    )
  }

  {
    description && (
      <div class="mt-3 text-center">
        <p class="text-sm text-gray-600 dark:text-gray-400">{description}</p>
      </div>
    )
  }

  <p data-form-status class="hidden mt-3 text-center text-sm font-medium text-red-600 dark:text-red-400" role="alert">
  </p>
</form>

<div
  data-form-success
  class="rounded-lg border border-emerald-200 dark:border-emerald-900 bg-emerald-50 dark:bg-emerald-900/20 px-6 py-10 text-center"
  tabindex="-1"
  role="status"
  hidden
>
  <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-emerald-100 dark:bg-emerald-900/50">
    <svg
      class="h-7 w-7 text-emerald-600 dark:text-emerald-400"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
      <path d="m9 11 3 3L22 4"></path>
    </svg>
  </span>
  <h3 class="mt-5 text-xl font-bold text-gray-900 dark:text-white">Merci ! Votre message a bien été envoyé.</h3>
  <p class="mt-2 text-gray-600 dark:text-gray-400">Je reviens vers vous au plus vite.</p>
  <button type="button" data-form-again class="btn-secondary mt-6">Envoyer un autre message</button>
</div>

<style>
  [data-form-success]:not([hidden]) {
    animation: form-success-in 0.3s ease-out;
  }
  @keyframes form-success-in {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  // Progressive enhancement for hosted form endpoints (Formspark): intercept
  // the submit, send it with `Accept: application/json` so the visitor stays
  // on the page, and surface the result inline. Without JS, the native POST
  // still goes through (Formspark then shows its own success page).
  const spinner = `<svg class="animate-spin h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 0 1 8-8v4a4 4 0 0 0-4 4H4z"></path></svg>`;

  const send = async (form: HTMLFormElement) => {
    const status = form.querySelector('[data-form-status]');
    const panel = form.nextElementSibling;
    const button = form.querySelector('[type="submit"]');
    const label = button?.innerHTML;
    let errorMessage = 'Une erreur est survenue lors de l’envoi. Merci de réessayer dans un instant.';

    if (status instanceof HTMLElement) {
      status.classList.add('hidden');
    }

    if (button instanceof HTMLButtonElement) {
      button.disabled = true;
      button.setAttribute('aria-busy', 'true');
      button.innerHTML = `${spinner}<span class="ml-2">Envoi en cours…</span>`;
    }

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Accept: 'application/json',
        },
        body: JSON.stringify(
          Object.fromEntries(Array.from(new FormData(form), ([key, value]) => [key, String(value)]))
        ),
      });

      if (!response.ok) {
        if (response.status === 403) {
          errorMessage =
            'Votre message a été refusé par la protection anti-spam. Merci d’éviter les textes de test et de reformuler votre demande.';
        }
        throw new Error(`Form endpoint replied ${response.status}`);
      }

      form.reset();
      form.classList.add('hidden');

      if (panel instanceof HTMLElement && panel.matches('[data-form-success]')) {
        panel.hidden = false;
        panel.focus();
      }
    } catch {
      if (status instanceof HTMLElement) {
        status.textContent = errorMessage;
        status.classList.remove('hidden');
      }
    } finally {
      if (button instanceof HTMLButtonElement) {
        button.disabled = false;
        button.removeAttribute('aria-busy');
        if (label) button.innerHTML = label;
      }
    }
  };

  document.addEventListener(
    'submit',
    (event) => {
      const form = event.target;

      if (!(form instanceof HTMLFormElement) || !form.action.includes('submit-form.com')) return;

      event.preventDefault();
      send(form);
    },
    true
  );

  document.addEventListener('click', (event) => {
    const trigger = event.target instanceof Element ? event.target.closest('[data-form-again]') : null;
    if (!trigger) return;

    const panel = trigger.closest('[data-form-success]');
    const form = panel?.previousElementSibling;

    if (!(panel instanceof HTMLElement) || !(form instanceof HTMLFormElement)) return;

    form.reset();
    form.classList.remove('hidden');
    panel.hidden = true;

    const firstField = form.querySelector('input, textarea');
    if (firstField instanceof HTMLElement) firstField.focus();
  });
</script>
