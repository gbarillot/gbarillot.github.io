---
import type { Form as Props } from '~/types';
import Button from '~/components/ui/Button.astro';

const { inputs, textarea, disclaimer, button = 'Contact us', description = '', action } = Astro.props;
---

<form method="POST" action={action}>
  {
    inputs &&
      inputs.map(
        ({ type = 'text', name, label = '', autocomplete = 'on', placeholder = '', required = false }) =>
          name && (
            <div class="mb-6">
              {label && (
                <label for={name} class="block text-sm font-medium">
                  {label}
                </label>
              )}
              <input
                type={type}
                name={name}
                id={name}
                autocomplete={autocomplete}
                placeholder={placeholder}
                required={required}
                class="py-3 px-4 block w-full text-md rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900"
              />
            </div>
          )
      )
  }

  {
    textarea && (
      <div>
        <label for="textarea" class="block text-sm font-medium">
          {textarea.label}
        </label>
        <textarea
          id="textarea"
          name={textarea.name ? textarea.name : 'message'}
          rows={textarea.rows ? textarea.rows : 4}
          placeholder={textarea.placeholder}
          required={textarea.required}
          class="py-3 px-4 block w-full text-md rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900"
        />
      </div>
    )
  }

  {
    disclaimer && (
      <div class="mt-3 flex items-start">
        <div class="flex mt-0.5">
          <input
            id="disclaimer"
            name="disclaimer"
            type="checkbox"
            required={disclaimer.required}
            class="cursor-pointer mt-1 py-3 px-4 block w-full text-md rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900"
          />
        </div>
        <div class="ml-3">
          <label for="disclaimer" class="cursor-pointer select-none text-sm text-gray-600 dark:text-gray-400">
            {disclaimer.label}
          </label>
        </div>
      </div>
    )
  }

  {
    button && (
      <div class="mt-10 grid">
        <Button variant="primary" type="submit">
          {button}
        </Button>
      </div>
    )
  }

  {
    description && (
      <div class="mt-3 text-center">
        <p class="text-sm text-gray-600 dark:text-gray-400">{description}</p>
      </div>
    )
  }

  <p data-form-status class="hidden mt-3 text-center text-sm font-medium" role="status" aria-live="polite"></p>
</form>

<script>
  // Progressive enhancement for hosted form endpoints (Formspark): intercept
  // the submit, send it with `Accept: application/json` so the visitor stays
  // on the page, and surface the result inline. Without JS, the native POST
  // still goes through (Formspark then shows its own success page).
  const send = async (form: HTMLFormElement) => {
    const status = form.querySelector('[data-form-status]');
    const button = form.querySelector('[type="submit"]');
    const label = button?.textContent;

    if (status instanceof HTMLElement) {
      status.classList.add('hidden');
      status.classList.remove('text-emerald-600', 'dark:text-emerald-400', 'text-red-600', 'dark:text-red-400');
    }

    if (button instanceof HTMLButtonElement) {
      button.disabled = true;
      button.setAttribute('aria-busy', 'true');
    }

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: new URLSearchParams(Array.from(new FormData(form), ([key, value]) => [key, String(value)])).toString(),
      });

      if (!response.ok) throw new Error(`Form endpoint replied ${response.status}`);

      form.reset();

      if (status instanceof HTMLElement) {
        status.textContent = 'Merci ! Votre message a bien été envoyé. Je reviens vers vous rapidement.';
        status.classList.add('text-emerald-600', 'dark:text-emerald-400');
        status.classList.remove('hidden');
      }
    } catch {
      if (status instanceof HTMLElement) {
        status.textContent = 'Une erreur est survenue lors de l’envoi. Merci de réessayer dans un instant.';
        status.classList.add('text-red-600', 'dark:text-red-400');
        status.classList.remove('hidden');
      }
    } finally {
      if (button instanceof HTMLButtonElement) {
        button.disabled = false;
        button.removeAttribute('aria-busy');
        if (label) button.textContent = label;
      }
    }
  };

  document.addEventListener(
    'submit',
    (event) => {
      const form = event.target;

      if (!(form instanceof HTMLFormElement) || !form.action.includes('submit-form.com')) return;

      event.preventDefault();
      send(form);
    },
    true
  );
</script>
